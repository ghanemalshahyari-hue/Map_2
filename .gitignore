# Dependencies
UI_MOdified/node_modules/

# Large map tile files
*.mbtiles

# Local/offline heavyweight artifacts. Keep these on disk or in transfer bundles,
# not in git history.
UI_MOdified/TestingAI/SmartSearch/litellm/litellm-image.tar
UI_MOdified/TestingAI/_archive/source_data/geo/*.tif
UI_MOdified/Offline_Deployment/dist/
UI_MOdified/Offline_Deployment/TestingAI_Runtime/runs/

# Uploads (user-generated at runtime)
UI_MOdified/uploads/

# Electron build output
dist/
build/

# OS files
Thumbs.db
Desktop.ini
.DS_Store
# macOS AppleDouble resource forks (E-drive/Mac recovery debris)
._*

# Editor files
.vscode/
*.swp
*.swo

# Claude Code local settings
.claude/

# Environment / secrets
.env
.env.*
# …but the committed TEMPLATES (no secrets, document the vars) stay tracked.
!UI_MOdified/.env.example
!UI_MOdified/Offline_Deployment/.env.offline.example

# Offline deployment CA certificate — operator-supplied at the site, never committed.
# Only the README placeholder in certs/ is committed.
UI_MOdified/Offline_Deployment/certs/*.crt
UI_MOdified/Offline_Deployment/certs/*.pem
UI_MOdified/Offline_Deployment/certs/*.key
UI_MOdified/Offline_Deployment/dist/bundle/.env.offline

# AI gateway local secrets (api keys, etc.) — never commit.
# `ai-config.js` is the committed defaults; this overlay file (if present)
# is loaded on top and is gitignored so secrets stay on the machine.
UI_MOdified/server/ai/ai-secrets.local.js

# RMOOZ-LOCAL-MODEL-SELECTOR-A: operator's runtime model choice — machine-local,
# set via the RMOOZ UI (POST /api/ai/model/select). Regenerated on demand.
UI_MOdified/runtime/

# SQLite databases (runtime data)
*.sqlite
*.db
*.db-wal
*.db-shm
UI_MOdified/data/units.db

# Runtime server logs — machine-local, regenerated every run, never commit.
UI_MOdified/data/logs/

# Atomic-write temp files from the server's write-then-rename save path
# (e.g. plans/<uuid>.geojson.tmp.<pid>.<timestamp>). Transient - never commit.
UI_MOdified/data/users/**/*.tmp.*

# RUNTIME-USER-PLAN-CLEANUP-1: user plan bodies are runtime state. Plan
# metadata lives in SQLite, and /api/plans creates/rewrites these GeoJSON files
# on demand, so tracking them makes test/server flows dirty. Keep only explicit
# fixture examples outside this runtime glob, if a future test needs one.
UI_MOdified/data/users/*/plans/*.geojson

# one-time bootstrap admin password — secret, never commit
UI_MOdified/data/BOOTSTRAP_PASSWORD.txt

# LOCAL-IMPORT-2: local Wargame output drop. Run folders copied here are bulk
# generated geojson (large, machine-local) — ignore them. Keep the folder on a
# fresh clone by tracking ONLY the README + .gitkeep.
UI_MOdified/data/imports/wargame_outputs/*
!UI_MOdified/data/imports/wargame_outputs/README.md
!UI_MOdified/data/imports/wargame_outputs/.gitkeep

# Generated Free Fight scenario drafts + the active-scenario pointer. These churn
# every run (created/deleted/rewritten by the app) and an external auto-commit
# kept polluting feature commits with thousands of lines of diff. Machine-local,
# regenerated by the app — never commit. Named reference scenarios (final.json,
# uk.json, wargame3.json, beirut-llm-test.json, …) are NOT matched and stay tracked.
UI_MOdified/data/scenarios/_active.json
UI_MOdified/data/scenarios/*draft*.json
# Dev/test scenario fixtures (e.g. test_gcc.json — 19k generated lines). Machine-local;
# the external auto-committer kept sweeping them into commits. Named reference scenarios
# (final.json, uk.json, wargame3.json, beirut-llm-test.json) start with other prefixes
# and are NOT matched — they stay tracked.
UI_MOdified/data/scenarios/test_*.json

# Local API key/archive secret files
UI_MOdified/TestingAI/_archive/apik.rtf

# MDMP-EXTERNAL-1: raw drop from the other AI app's MDMP pipeline. Its
# step2_task_analysis.py carries internal LLM endpoint IPs — never commit the
# raw folder. Sanitized key-schema fixtures live (tracked) under
# UI_MOdified/devtools/fixtures/mdmp-external/.
UI_MOdified/TestingAI/Other_App_Ai_Generated output/

# Generated knowledge-graph output (/graphify). Large (graph.json 50MB+) and
# regenerated by the /graphify commit hook on every commit → huge noisy diffs +
# GitHub >50MB warnings. Keep the files on disk, never track them.
graphify-out/

# RUNTIME-OVERRIDES-CLEANUP-1: operator scenario overrides are app-written
# runtime state (written by writeObjectiveOverride in wargame-sim-bridge.js when
# the operator saves in the Scenario Setup wizard). Tracking it kept the worktree
# perpetually dirty and collided on every pull/fast-forward. Both readers (Node
# readObjectiveOverride + Python apply_json_objective_override) tolerate absence
# → default objective, so keeping it untracked is safe. The committed default
# lives in scenario_overrides.example.json (copy it to bootstrap a fixed default).
UI_MOdified/TestingAI/WarGamingGEN/inputs/scenario_overrides.json
